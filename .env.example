# --- model endpoint (required to run analysis) ----------------------------- #
MODEL_PROVIDER=OpenAI
API_BASE=
API_KEY=
MODEL_NAME=
VISION_MODEL_NAME=deepseek-v4-flash-vision-exp
LLM_TEMPERATURE=0.2
VISION_TEMPERATURE=0.2
LLM_TIMEOUT=180
LLM_RETRIES=2
LLM_SSL_VERIFY=false

# --- run constraints & observability --------------------------------------- #
TOKEN_BUDGET=0
TRACE_CALLBACKS=false
SAVE_CALL_IO=true
RAILS=true

# --- application behaviour -------------------------------------------------- #
AGENTIC_MODE=false
VERIFY_FIX=true
FRAME_FPS=2
MAX_FRAMES=12
CURSOR_MOTION_THRESHOLD=6
REPRO_MAX_STEPS=20
STEP_TIMEOUT_S=15
PROOF_WIDTH=720
# command run in the patched repo to verify the fix (empty = skip real test run)
TEST_COMMAND=
# command that serves the app from a repo checkout, for the patched-app proof re-run
# (empty = the app must already be running at --app; the re-run is skipped)
APP_START_COMMAND=
PATCHED_APP_URL=http://localhost:3000

# --- GitHub App (the forge owns these; backend never sees them) ------------- #
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- sandbox runner (empty = run jobs in-process; set an image to wrap in Docker) ---
SANDBOX_IMAGE=
SANDBOX_CPU=1
SANDBOX_MEMORY=1g

# --- embeddings (optional; enables the memory rail) ------------------------ #
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL_NAME=text-embedding-v3
