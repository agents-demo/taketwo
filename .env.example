# --- model endpoint (required to run analysis) ----------------------------- #
MODEL_PROVIDER=OpenAI
API_BASE=
API_KEY=
MODEL_NAME=
VISION_MODEL_NAME=deepseek-v4-flash-vision-exp
LLM_TEMPERATURE=0.2
VISION_TEMPERATURE=0.2
LLM_TIMEOUT=180
LLM_RETRIES=2
LLM_SSL_VERIFY=false

# --- run constraints & observability --------------------------------------- #
TOKEN_BUDGET=0
TRACE_CALLBACKS=false
SAVE_CALL_IO=true
RAILS=true

# --- application behaviour -------------------------------------------------- #
AGENTIC_MODE=false
VERIFY_FIX=true
FRAME_FPS=2
MAX_FRAMES=12
OCR_LANG=eng
CURSOR_MOTION_THRESHOLD=6
REPRO_MAX_STEPS=20
STEP_TIMEOUT_S=15
PROOF_WIDTH=720

# --- GitHub App (the forge owns these; backend never sees them) ------------- #
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- embeddings (optional; enables the memory rail) ------------------------ #
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL_NAME=text-embedding-v3
